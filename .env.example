# Supabase — copy this file to `.env` (or `.env.local`) and fill in your values.
# Both are safe to expose in the browser: RLS protects the data.

VITE_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR-ANON-PUBLIC-KEY"

// Optional: country code prepended to the mobile number entered at sign-in.
// (The user types their local number; we send the full E.164 number to Supabase.)
VITE_AUTH_PHONE_PREFIX="+960"

# Optional: domain used to build the synthetic sign-in email from the mobile
# number, e.g. 7XXXXXX -> 7XXXXXX@salonos.app (the Email provider needs no SMS).
VITE_AUTH_EMAIL_DOMAIN="salonos.app"
